# SIGO-Dental Environment Configuration Template (SRS §7, RNF-04, RNF-05)
#
# Plantilla de variables del stack local. Cada valor de este archivo
# SOBREESCRIBE el valor por defecto declarado en compose.yaml, así que
# ambos archivos tienen que mantenerse alineados.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------
# PostgreSQL 16 (almacenamiento transaccional, AES-256 at rest)
# ---------------------------------------------------------------------
POSTGRES_USER=sigo_admin
POSTGRES_PASSWORD=sigo_secret_change_me
POSTGRES_DB=sigo_dental

# ---------------------------------------------------------------------
# Redis 7 (sesiones idle de 15 min y colas de notificación)
# ---------------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=sigo_redis_secret_change_me
SESSION_IDLE_TTL_SECONDS=900

# ---------------------------------------------------------------------
# RustFS / S3 Object Storage (radiografías, fotos clínicas, consentimientos)
#
# RustFS acepta RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY. MINIO_ROOT_USER y
# MINIO_ROOT_PASSWORD son los alias deprecados: usá las canónicas.
# ---------------------------------------------------------------------
RUSTFS_ACCESS_KEY=sigo_rustfs_admin
RUSTFS_SECRET_KEY=sigo_rustfs_secret_change_me
S3_BUCKET=sigo-clinical-blobs
S3_ENDPOINT=http://rustfs:9000

# ---------------------------------------------------------------------
# API Gateway / Edge Ingress (RNF-01, RNF-03, RNF-04, RNF-05)
#
# Los puertos publicados NO son los habituales a propósito: este stack está
# pensado para quedar prendido junto a otros proyectos locales sin pelear
# por 8080 / 8443. Los puertos internos del contenedor (8080 / 8443) no
# cambian nunca; sólo cambia el lado del host.
# ---------------------------------------------------------------------
GATEWAY_HTTP_PORT=18080
GATEWAY_HTTPS_PORT=18443
TLS_MIN_VERSION=1.3
TLS_CERT_FILE=
TLS_KEY_FILE=
JWT_SECRET=sigo_hs256_production_secret_32bytes_min!
CLINICAL_AGENDA_UPSTREAM=http://clinical-agenda:8081
BILLING_STOCK_UPSTREAM=http://billing-stock:8082
# Origen permitido por CORS. Es el mismo origen que sirve el portal.
ALLOWED_ORIGIN=http://localhost:18777
OPENAPI_SPEC_PATH=/app/openapi/sigo-dental.v1.yaml

# ---------------------------------------------------------------------
# Frontend Portal (Next.js App Router PWA)
# ---------------------------------------------------------------------
FRONTEND_PORT=18777
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:18080
# URL que usan los server components y las server actions para hablar con el
# gateway por la red interna de compose. El navegador nunca la ve: el portal
# es same-origin, así que no hay CORS y el gateway no queda expuesto.
GATEWAY_INTERNAL_URL=http://api-gateway:8080
# Poner en "true" cuando el portal se publique detrás de TLS (por ejemplo
# detrás de un túnel de Cloudflare). Con HTTP plano tiene que ser "false",
# porque un cookie Secure no se guarda en http://localhost.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------
# Interruptores de desarrollo (wi-18)
#
# MFA_REQUIRED=false            → la contraseña abre la sesión (sin TOTP).
# NEXT_PUBLIC_DEV_ROLE_LOGIN=true → muestra el selector de rol en el login.
#   OJO: ese selector mete las credenciales sembradas en el bundle del
#   navegador. Ponelo en "false" ANTES de exponer el stack a internet.
# SIGO_SEED_DEMO_DATA=true       → siembra el juego de datos de demostración.
# ---------------------------------------------------------------------
MFA_REQUIRED=false
NEXT_PUBLIC_DEV_ROLE_LOGIN=true
SIGO_SEED_DEMO_DATA=true

# ---------------------------------------------------------------------
# Cloudflare Tunnel (perfil "tunnel")
#
# Pegá acá el token del túnel creado en el panel de Cloudflare:
#   Cloudflare → Zero Trust → Networks → Tunnels → Create a tunnel
# El hostname público se configura en ese mismo panel y debe apuntar a
#     http://frontend:3000
# (el nombre del servicio de compose, no localhost).
#
# Para levantar el túnel:
#   docker compose --profile tunnel up -d
# ---------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
