# SIGO-Dental Environment Configuration Template (SRS §7, RNF-04, RNF-05)

# PostgreSQL 16 (Transactional Store — AES-256 at rest)
POSTGRES_USER=sigo_admin
POSTGRES_PASSWORD=sigo_secret_change_me
POSTGRES_DB=sigo_dental

# Redis 7 (Session Idle Tracking 15m TTL & Notification Queues)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=sigo_redis_secret_change_me
SESSION_IDLE_TTL_SECONDS=900

# MinIO / S3 Object Storage (Radiographs, Clinical Photos, Signed Consents)
MINIO_ROOT_USER=sigo_minio_admin
MINIO_ROOT_PASSWORD=sigo_minio_secret_change_me
MINIO_KMS_SECRET_KEY=sigo-aes256-master-key:OS1kZWZhdWx0LWFlczI1Ni1rZXktZm9yLXNpZ28tZGVudGFsLTIwMjY=
S3_BUCKET=sigo-clinical-blobs

# API Gateway / Edge Ingress (RNF-01, RNF-03, RNF-04, RNF-05)
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443
TLS_MIN_VERSION=1.3
TLS_CERT_FILE=
TLS_KEY_FILE=
JWT_SECRET=sigo_hs256_production_secret_32bytes_min!
CLINICAL_AGENDA_UPSTREAM=http://clinical-agenda:8081
BILLING_STOCK_UPSTREAM=http://billing-stock:8082
CORS_ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_RPS=200
RATE_LIMIT_BURST=300
OPENAPI_SPEC_PATH=../../openapi/sigo-dental.v1.yaml

# Frontend Portal (Next.js App Router PWA)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080
